{
    // 鹰角启动器状态检测：在 GameLauncherSelectEndfield 之后、GameLauncherClickStartGame 之前分流。
    // 仅使用本地截图 + 识别 + 点击；不请求启动器接口、不读写启动器配置、不修改游戏本体。
    // 界面链条：GameLauncherSelectEndfield（左栏点终末地）→ 本文件分流 → GameLauncherClickStartGame
    //           （右下点开始游戏）→ GameLauncherInGame（OCR「游戏中」确认启动成功）。
    // 分流依据（均取自启动器窗口右下角）：
    //   「更新游戏」→ 点击 → 「系统提示」弹窗「确认」→ 等按钮变回「开始游戏」→ 交回官方节点；
    //   黄色圆钮 + 「云+下箭头」图标 → 点击预下载（下载期间仍可正常游戏）→ 同上回官方节点；
    //   其余情况（含已暂停/已完成/出错图标）不动作，直接交回官方节点。
    "GameLauncherStateCheck": {
        "desc": "已选中终末地：先判断是否需要更新、是否存在预下载，再走官方启动流程",
        "next": [
            "GameLauncherUpdateGame",
            "GameLauncherPreDownloadIdle",
            "GameLauncherClickStartGame"
        ]
    },
    "GameLauncherUpdateGame": {
        "desc": "右下角按钮显示「更新游戏」，点击开始更新",
        "recognition": "OCR",
        "roi": [
            -320,
            -140,
            320,
            140
        ],
        // 启动器界面文案由启动器自身下发，不进入游戏 i18n 表，与官方 GameLauncherStartGameText 同样跳过
        "expected": [
            // @i18n-skip
            "更新游戏"
        ],
        "action": "Click",
        "next": [
            "GameLauncherConfirmDialog",
            "GameLauncherWaitStartGame"
        ]
    },
    "GameLauncherConfirmDialog": {
        "desc": "「系统提示」弹窗上的「确认」按钮（更新与预下载共用同一弹窗布局）",
        "recognition": "And",
        "all_of": [
            "GameLauncherConfirmDialogTitle",
            "GameLauncherConfirmDialogConfirm"
        ],
        "box_index": 1,
        "action": "Click",
        "next": [
            "GameLauncherWaitStartGame"
        ]
    },
    "GameLauncherConfirmDialogTitle": {
        "desc": "弹窗标题「系统提示」",
        "recognition": "OCR",
        "roi": [
            -780,
            -520,
            300,
            110
        ],
        // 同上：弹窗标题与按钮文案均由启动器下发
        "expected": [
            // @i18n-skip
            "系统提示"
        ]
    },
    "GameLauncherConfirmDialogConfirm": {
        "desc": "弹窗右下角的白底「确认」",
        "recognition": "OCR",
        "roi": [
            -660,
            -330,
            320,
            140
        ],
        // 同上：弹窗标题与按钮文案均由启动器下发
        "expected": [
            // @i18n-skip
            "确认"
        ]
    },
    "GameLauncherWaitStartGame": {
        "desc": "等待更新完成：每帧重新识别右下角按钮，直到显示「开始游戏」（轮询依赖全局 rate_limit，无固定延迟）",
        // 本文件唯一的 timeout：-1 表示不设上限。等待完全由「识别 → 未命中 → 下一帧」驱动，
        // 不用固定延迟；若沿用默认 20s，更新中途就会误判失败。
        "timeout": -1,
        "next": [
            "GameLauncherConfirmDialog",
            "GameLauncherClickStartGame"
        ]
    },
    "GameLauncherPreDownloadRing": {
        "desc": "预下载圆钮的黄色实心圆（启动器主题色）",
        "recognition": "ColorMatch",
        "roi": [
            -410,
            -140,
            100,
            110
        ],
        "lower": [
            240,
            240,
            0
        ],
        "upper": [
            255,
            255,
            60
        ],
        "connected": true,
        "count": 1500
    },
    "GameLauncherPreDownloadIdleIcon": {
        "desc": "圆钮内的「云+下箭头」图标：仅未开始下载时出现（已暂停/已完成/出错为其他图标）",
        "recognition": "TemplateMatch",
        "roi": [
            -410,
            -140,
            100,
            110
        ],
        "template": "GameLauncher/PreDownloadIdle.png",
        "threshold": 0.8
    },
    "GameLauncherPreDownloadIdle": {
        "desc": "存在预下载圆钮且图标为「云+下箭头」，点击触发预下载（下载期间可正常游戏）",
        "recognition": "And",
        "all_of": [
            "GameLauncherPreDownloadRing",
            "GameLauncherPreDownloadIdleIcon"
        ],
        "box_index": 1,
        "action": "Click",
        "next": [
            "GameLauncherConfirmDialog",
            "GameLauncherWaitStartGame"
        ]
    }
}
